# Configuración para sincronización SonarCloud -> GitHub Issues

# URL base de SonarCloud (por defecto https://sonarcloud.io)
SONAR_HOST_URL=https://sonarcloud.io

# Clave del proyecto en SonarCloud
SONAR_PROJECT_KEY=ematevar_SIGOC-web

# Organización en SonarCloud
SONAR_ORGANIZATION=ematevar

# Token de SonarCloud (Opcional si el proyecto es público)
SONAR_TOKEN=

# Repositorio GitHub destino
GITHUB_REPOSITORY=ematevar/SIGOC-web

# Token personal de GitHub con permisos de 'issues:write' (repo)
# (Opcional si tienes instalada la GitHub CLI y has iniciado sesión con 'gh auth login')
GITHUB_TOKEN=
