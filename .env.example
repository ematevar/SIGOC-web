# ============================================================
# Plantilla de variables de entorno para SIGOC Web
# Copia este archivo como .env (no se sube a Git) o define
# estas variables en tu sistema operativo / servidor VPS.
# ============================================================

SERVER_PORT=8080
COOKIE_SECURE=false

# Base de datos MySQL 8
DB_URL=jdbc:mysql://localhost:3306/sigoc_db?useSSL=true&serverTimezone=America/Lima&allowPublicKeyRetrieval=true
DB_USERNAME=sigoc_app
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA

# PayPal Sandbox (PayPal Developer -> Apps & Credentials)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_TIMEOUT_SECONDS=10

# Vigencia en horas del enlace público de pago
PAGO_ENLACE_HORAS=72
JPA_SHOW_SQL=false
